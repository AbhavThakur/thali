{
  "name": "thali",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npm install expo@latest && npx expo install expo-router expo-sqlite expo-linking expo-constants expo-status-bar react-native-svg react-native-safe-area-context react-native-screens react react-native && npx expo install typescript @types/react -- --save-dev",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --experimental-strip-types --no-warnings --test 'src/domain/__tests__/*.test.ts'",
    "build": "npx expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "^57.0.29",
    "expo-constants": "~57.0.22",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
